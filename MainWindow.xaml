<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HNReader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HNReader"
	xmlns:helpers="using:HNReader"
	xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="HNReader"
>

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

  <Grid
	Name="RootGrid"
	Loaded="RootGrid_Loaded">
	<Grid.ColumnDefinitions>
	  <ColumnDefinition Width="360" MinWidth="240" MaxWidth="480"/>
	  <ColumnDefinition Width="*"/>
	</Grid.ColumnDefinitions>

	<!-- SIDEBAR -->
	<Grid Grid.Column="0" x:Name="LeftPane" Background="{ThemeResource LayerFillColorDefaultBrush}">
	  <Grid.RowDefinitions>
		<RowDefinition Height="*"/>
		<RowDefinition Height="Auto"/>
	  </Grid.RowDefinitions>

	  <!-- Scrollable list of posts -->
	  <ListView x:Name="PostsList"
          Margin="0"
          Padding="0"
          SelectionMode="Single"
          IsItemClickEnabled="True"
          ItemClick="PostsList_ItemClick"
		  Loaded="PostsList_Loaded"
          xmlns:local="using:HNReader">
		<ListView.ItemTemplate>
		  <DataTemplate x:DataType="local:Post">
			<Border Padding="8" Margin="0,0" Background="Transparent" CornerRadius="6">
			  <StackPanel>
				<!-- Title (big) -->
				<TextBlock Text="{x:Bind Title}"
                               FontSize="16"
							   FontFamily="{StaticResource InterTight}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />

				<!-- Meta row: author | score | comments -->
				<StackPanel Orientation="Horizontal" Margin="0,2,0,0" Spacing="4">
				  <TextBlock Text="{x:Bind By}" FontSize="14" FontFamily="{StaticResource InterTight}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
				  <TextBlock Text="•" FontSize="14" FontFamily="{StaticResource InterTight}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
				  <TextBlock Text="{x:Bind ScoreText}" FontSize="14" FontFamily="{StaticResource InterTight}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
				  <TextBlock Text="•" FontSize="14" FontFamily="{StaticResource InterTight}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
				  <TextBlock Text="{x:Bind CommentCountText}" FontSize="14" FontFamily="{StaticResource InterTight}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
				</StackPanel>

				<!-- Time and URL row (smaller) -->
				<StackPanel Orientation="Horizontal" Margin="0,2,0,0" Spacing="4" VerticalAlignment="Center">
				  <TextBlock Text="{x:Bind TimeAgo}" FontSize="12" FontFamily="{StaticResource InterTight}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
				  <TextBlock Text="•" FontSize="12" FontFamily="{StaticResource InterTight}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
				  <TextBlock Text="{x:Bind DisplayUrl}" FontSize="12" FontFamily="{StaticResource InterTight}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
				</StackPanel>
			  </StackPanel>
			</Border>
		  </DataTemplate>
		</ListView.ItemTemplate>
		<ListView.Footer>
		  <StackPanel HorizontalAlignment="Center" Padding="8">
			<ProgressRing x:Name="PostsFooterProgress" IsActive="False" Visibility="Collapsed" Width="28" Height="28"/>
		  </StackPanel>
		</ListView.Footer>
	  </ListView>

	  <!-- Bottom toolbar -->
	  <StackPanel Grid.Row="1"
            Orientation="Horizontal"
            Background="{ThemeResource LayerFillColorAltBrush}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
			Padding="0"
			Spacing="0"
            >

		<AppBarButton x:Name="HomeButton" Icon="Home" Height="48" Width="48"/>
		<AppBarButton x:Name="SettingsButton" Icon="Setting" Height="48" Width="48"/>
		<AppBarButton x:Name="SaveOfflineButton" Icon="Save" Height="48" Width="48" Click="SaveOfflineButton_Click"/>
		<AppBarButton x:Name="RefreshButton" Icon="Refresh" Height="48" Width="48" Click="RefreshButton_Click"/>

	  </StackPanel>
	</Grid>

	<!-- MAIN CONTENT AREA -->
	<Grid Grid.Column="1" x:Name="MainContentGrid" Background="{ThemeResource LayerFillColorAltBrush}">
	  <Grid.RowDefinitions>
		<RowDefinition Height="Auto"/>
		<!-- metadata -->
		<RowDefinition Height="Auto"/>
		<!-- post text label (only visible when text exists) -->
		<RowDefinition Height="Auto"/>
		<!-- article body (collapses when empty) -->
		<RowDefinition Height="*"/>
		<!-- comments take remaining space -->
	  </Grid.RowDefinitions>

	  <!-- Metadata area -->
	  <Grid Grid.Row="0" x:Name="MetadataGrid">
		<Grid x:Name="CommentsLoadingOverlay" Background="#40000000" Visibility="Collapsed" IsHitTestVisible="False">
		  <ProgressRing x:Name="CommentsProgressRing" IsActive="True" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
		</Grid>
		<Border Padding="8" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
		  <Grid
		  ColumnSpacing="8">
			<Grid.ColumnDefinitions>
			  <ColumnDefinition Width="Auto" />
			  <ColumnDefinition Width="*" />
			  <ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<AppBarButton Grid.Column="0" x:Name="OpenInBrowserIcon" Icon="Globe" Click="OpenUrlButton_Click" IsEnabled="False" HorizontalAlignment="Left" Width="48" Height="48" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
			<StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,0,0" Spacing="0">
			  <TextBlock x:Name="PostTitleText"
                 Text="Select a post from the sidebar"
                 FontSize="20"
			     FontFamily="{StaticResource InterTight}"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap"/>
			  <TextBlock x:Name="PostMetaText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
			</StackPanel>
			<StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
			  <AppBarButton x:Name="IncreaseFontSizeIcon" Icon="Add" Click="IncreaseFontSize_Click" IsEnabled="False" HorizontalAlignment="Right" Width="48" Height="48" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
			  <AppBarButton x:Name="ResetFontSizeIcon" Icon="Refresh" Click="ResetFontSize_Click" IsEnabled="False" HorizontalAlignment="Right" Width="48" Height="48" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
			  <AppBarButton x:Name="DecreaseFontSizeIcon" Icon="Remove" Click="DecreaseFontSize_Click" IsEnabled="False" HorizontalAlignment="Right" Width="48" Height="48" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
			</StackPanel>
		  </Grid>
		</Border>
	  </Grid>

	  <!-- Optional small label for self-text presence -->
	  <TextBlock Grid.Row="1" x:Name="PostTextLabel"
             Text="Post text"
             FontSize="14"
		     FontFamily="{StaticResource InterTight}"
             Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
             Margin="16,8,16,6"
             Visibility="Collapsed" />

	  <!-- Article body: wrap in a named ScrollViewer so we can collapse it -->
	  <ScrollViewer Grid.Row="2" x:Name="ArticleBodyScrollViewer" Margin="16,0,16,8"
                VerticalScrollMode="Enabled"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                IsEnabled="False">
		<!-- start collapsed until a post with text is shown -->
		<RichTextBlock x:Name="ArticleBody" FontSize="14" FontFamily="{StaticResource InterTight}" TextWrapping="Wrap" MaxWidth="900" Padding="6"/>
	  </ScrollViewer>
	  <TreeView Grid.Row="3"
          x:Name="CommentsTree"
          Margin="0"
		  Background="Transparent"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ItemInvoked="CommentsTree_ItemInvoked"
		  Loaded="CommentsTree_Loaded"
		  LayoutUpdated="CommentsTree_LayoutUpdated">

		  <TreeView.ItemTemplate>
			<DataTemplate>
			  <Grid Padding="2" HorizontalAlignment="Stretch">
				<Grid.RowDefinitions>
				  <RowDefinition Height="Auto"/>
				  <RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
				  <!-- note: Content.By because the data item is a TreeViewNode whose Content is your Comment -->
				  <TextBlock Text="{Binding Content.By}" FontSize="12" FontWeight="Medium" FontFamily="{StaticResource InterTight}" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
				<TextBlock Text="{Binding Content.ScoreAndTime}" FontSize="12" FontFamily="{StaticResource InterTight}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
				</StackPanel>

				<!-- Html attached property bound to Content.Text -->
				<RichTextBlock Grid.Row="1"
                       helpers:HtmlExtensions.Html="{Binding Content.Text}"
                       TextWrapping="Wrap"
                       FontSize="16"
					   FontFamily="{StaticResource InterTight}"
                       Margin="2,2,0,0"
                       HorizontalAlignment="Stretch"
					   Loaded="CommentRichText_Loaded" />
			  </Grid>
			</DataTemplate>
		  </TreeView.ItemTemplate>
		</TreeView>

	  </Grid>

  </Grid>
</Window>
