<?xml version="1.0" encoding="utf-8" ?>
<Window
	x:Class="HNReader.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:HNReader"
	xmlns:local="using:HNReader"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
	Title="HNReader"
	mc:Ignorable="d">

	<Window.SystemBackdrop>
		<MicaBackdrop />
	</Window.SystemBackdrop>

	<Grid Name="RootGrid" Loaded="RootGrid_Loaded">
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="360"
				MinWidth="240"
				MaxWidth="480" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<!--  SIDEBAR  -->
		<Grid
			x:Name="LeftPane"
			Grid.Column="0"
			Background="{ThemeResource LayerFillColorDefaultBrush}">
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!--  Scrollable list of posts  -->
			<ListView
				xmlns:local="using:HNReader"
				x:Name="PostsList"
				Margin="0"
				Padding="0"
				IsItemClickEnabled="True"
				ItemClick="PostsList_ItemClick"
				Loaded="PostsList_Loaded"
				SelectionMode="Single">
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="local:Post">
						<Border
							Margin="0,0"
							Padding="8"
							Background="Transparent"
							CornerRadius="6">
							<StackPanel>
								<!--  Title (big)  -->
								<TextBlock
									FontFamily="{StaticResource InterTight}"
									FontSize="16"
									FontWeight="SemiBold"
									Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
									Text="{x:Bind Title}"
									TextWrapping="Wrap" />

								<!--  Meta row: author | score | comments  -->
								<StackPanel
									Margin="0,2,0,0"
									Orientation="Horizontal"
									Spacing="4">
									<TextBlock
										VerticalAlignment="Center"
										FontFamily="{StaticResource InterTight}"
										FontSize="14"
										Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
										Text="{x:Bind By}" />
									<TextBlock
										VerticalAlignment="Center"
										FontFamily="{StaticResource InterTight}"
										FontSize="14"
										Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
										Text="•" />
									<StackPanel Orientation="Horizontal" Spacing="4">

										<Button
											MinWidth="24"
											MinHeight="16"
											Padding="0"
											Click="PostUpvote_Click"
											Tag="{x:Bind Id}"
											ToolTipService.ToolTip="Upvote">
											<FontIcon FontSize="12" Glyph="&#xE70E;" />
										</Button>

										<TextBlock
											VerticalAlignment="Center"
											FontFamily="{StaticResource InterTight}"
											FontSize="14"
											Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
											Text="{x:Bind ScoreText}" />
									</StackPanel>
									<TextBlock
										VerticalAlignment="Center"
										FontFamily="{StaticResource InterTight}"
										FontSize="14"
										Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
										Text="•" />
									<TextBlock
										VerticalAlignment="Center"
										FontFamily="{StaticResource InterTight}"
										FontSize="14"
										Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
										Text="{x:Bind CommentCountText}" />
								</StackPanel>

								<!--  Time and URL row (smaller)  -->
								<StackPanel
									Margin="0,2,0,0"
									VerticalAlignment="Center"
									Orientation="Horizontal"
									Spacing="4">
									<TextBlock
										FontFamily="{StaticResource InterTight}"
										FontSize="12"
										Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
										Text="{x:Bind TimeAgo}" />
									<TextBlock
										FontFamily="{StaticResource InterTight}"
										FontSize="12"
										Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
										Text="•" />
									<TextBlock
										MaxWidth="220"
										FontFamily="{StaticResource InterTight}"
										FontSize="12"
										Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
										Text="{x:Bind DisplayUrl}"
										TextTrimming="CharacterEllipsis" />
								</StackPanel>
							</StackPanel>
						</Border>
					</DataTemplate>
				</ListView.ItemTemplate>
				<ListView.Footer>
					<StackPanel Padding="8" HorizontalAlignment="Center">
						<ProgressRing
							x:Name="PostsFooterProgress"
							Width="28"
							Height="28"
							IsActive="False"
							Visibility="Collapsed" />
					</StackPanel>
				</ListView.Footer>
			</ListView>

			<!--  Bottom toolbar  -->
			<StackPanel
				Grid.Row="1"
				Padding="0"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Center"
				Background="{ThemeResource LayerFillColorAltBrush}"
				Orientation="Horizontal"
				Spacing="0">

				<AppBarButton
					x:Name="AccountButton"
					Width="48"
					Height="48"
					Click="AccountButton_Click"
					Icon="Account" />
				<AppBarButton
					x:Name="SettingsButton"
					Width="48"
					Height="48"
					Icon="Setting" />
				<AppBarButton
					x:Name="SaveOfflineButton"
					Width="48"
					Height="48"
					Click="SaveOfflineButton_Click"
					Icon="Save" />
				<AppBarButton
					x:Name="RefreshButton"
					Width="48"
					Height="48"
					Click="RefreshButton_Click"
					Icon="Refresh" />

			</StackPanel>
		</Grid>

		<!--  MAIN CONTENT AREA  -->
		<Grid
			x:Name="MainContentGrid"
			Grid.Column="1"
			Background="{ThemeResource LayerFillColorAltBrush}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<!--  metadata  -->
				<RowDefinition Height="Auto" />
				<!--  post text label (only visible when text exists)  -->
				<RowDefinition Height="Auto" />
				<!--  article body (collapses when empty)  -->
				<RowDefinition Height="*" />
				<!--  comments take remaining space  -->
			</Grid.RowDefinitions>

			<!--  Metadata area  -->
			<Grid x:Name="MetadataGrid" Grid.Row="0">
				<Grid
					x:Name="CommentsLoadingOverlay"
					Background="#40000000"
					IsHitTestVisible="False"
					Visibility="Collapsed">
					<ProgressRing
						x:Name="CommentsProgressRing"
						Width="48"
						Height="48"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
						IsActive="True" />
				</Grid>
				<Border
					Padding="8"
					BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
					BorderThickness="0,0,0,1">
					<Grid ColumnSpacing="8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<AppBarButton
							x:Name="OpenInBrowserIcon"
							Grid.Column="0"
							Width="48"
							Height="48"
							HorizontalAlignment="Left"
							HorizontalContentAlignment="Center"
							VerticalContentAlignment="Center"
							Click="OpenUrlButton_Click"
							Icon="Globe"
							IsEnabled="False" />
						<StackPanel
							Grid.Column="1"
							Margin="0,0,0,0"
							Orientation="Vertical"
							Spacing="0">
							<TextBlock
								x:Name="PostTitleText"
								FontFamily="{StaticResource InterTight}"
								FontSize="20"
								FontWeight="SemiBold"
								Text="Select a post from the sidebar"
								TextWrapping="Wrap" />
							<TextBlock
								x:Name="PostMetaText"
								FontSize="14"
								FontWeight="SemiBold"
								Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
								TextWrapping="Wrap" />
						</StackPanel>
						<StackPanel
							Grid.Column="2"
							HorizontalAlignment="Right"
							VerticalAlignment="Center"
							Orientation="Horizontal">
							<AppBarButton
								x:Name="IncreaseFontSizeIcon"
								Width="48"
								Height="48"
								HorizontalAlignment="Right"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								Click="IncreaseFontSize_Click"
								Icon="Add"
								IsEnabled="False" />
							<AppBarButton
								x:Name="ResetFontSizeIcon"
								Width="48"
								Height="48"
								HorizontalAlignment="Right"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								Click="ResetFontSize_Click"
								Icon="Refresh"
								IsEnabled="False" />
							<AppBarButton
								x:Name="DecreaseFontSizeIcon"
								Width="48"
								Height="48"
								HorizontalAlignment="Right"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								Click="DecreaseFontSize_Click"
								Icon="Remove"
								IsEnabled="False" />
						</StackPanel>
					</Grid>
				</Border>
			</Grid>

			<!--  Optional small label for self-text presence  -->
			<TextBlock
				x:Name="PostTextLabel"
				Grid.Row="1"
				Margin="16,8,16,6"
				FontFamily="{StaticResource InterTight}"
				FontSize="14"
				Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
				Text="Post text"
				Visibility="Collapsed" />

			<!--  Article body: wrap in a named ScrollViewer so we can collapse it  -->
			<ScrollViewer
				x:Name="ArticleBodyScrollViewer"
				Grid.Row="2"
				Margin="16,0,16,8"
				HorizontalScrollBarVisibility="Disabled"
				HorizontalScrollMode="Disabled"
				IsEnabled="False"
				VerticalScrollBarVisibility="Auto"
				VerticalScrollMode="Enabled">
				<!--  start collapsed until a post with text is shown  -->
				<RichTextBlock
					x:Name="ArticleBody"
					MaxWidth="900"
					Padding="6"
					FontFamily="{StaticResource InterTight}"
					FontSize="14"
					TextWrapping="Wrap" />
			</ScrollViewer>
			<TreeView
				x:Name="CommentsTree"
				Grid.Row="3"
				Margin="0"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				Background="Transparent"
				LayoutUpdated="CommentsTree_LayoutUpdated"
				Loaded="CommentsTree_Loaded">

				<TreeView.ItemTemplate>
					<DataTemplate>
						<Grid Padding="2" HorizontalAlignment="Stretch">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<StackPanel
								Grid.Row="0"
								VerticalAlignment="Center"
								Orientation="Horizontal"
								Spacing="8">
								<!--  note: Content.By because the data item is a TreeViewNode whose Content is your Comment  -->
								<TextBlock
									VerticalAlignment="Center"
									FontFamily="{StaticResource InterTight}"
									FontSize="12"
									FontWeight="Medium"
									Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
									Text="{Binding Content.By}" />
								<StackPanel Orientation="Horizontal" Spacing="8">

									<Button
										MinWidth="24"
										MinHeight="16"
										Padding="0"
										Click="CommentUpvote_Click"
										Tag="{Binding Content.Id}"
										ToolTipService.ToolTip="Upvote">
										<FontIcon FontSize="12" Glyph="&#xE70E;" />
									</Button>

									<TextBlock
										VerticalAlignment="Center"
										FontFamily="{StaticResource InterTight}"
										FontSize="12"
										Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
										Text="{Binding Content.ScoreAndTime}" />
								</StackPanel>
							</StackPanel>

							<!--  Html attached property bound to Content.Text  -->
							<RichTextBlock
								Grid.Row="1"
								Margin="2,2,0,0"
								HorizontalAlignment="Stretch"
								helpers:HtmlExtensions.Html="{Binding Content.Text}"
								FontFamily="{StaticResource InterTight}"
								FontSize="14"
								Loaded="CommentRichText_Loaded"
								TextWrapping="Wrap" />
						</Grid>
					</DataTemplate>
				</TreeView.ItemTemplate>
			</TreeView>

		</Grid>

	</Grid>
</Window>
